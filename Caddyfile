# Раздача site/dist. Домен — из SITE_DOMAIN, HTTPS Caddy получает сам.
{$SITE_DOMAIN} {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Всё своё: ни скриптов, ни внешних ресурсов (JSON-LD — не исполняемый код).
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	@static path /static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	@pages not path /static/*
	header @pages Cache-Control "public, max-age=300"

	@txt path /llms.txt /robots.txt
	header @txt Content-Type "text/plain; charset=utf-8"

	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
